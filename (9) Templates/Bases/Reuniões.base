filters:
  and:
    - categorias.contains(link("Reuniões"))
    - '!file.name.contains("Template")'
properties:
  note.date:
    displayName: Date
  note.pessoas:
    displayName: Pessoas
  note.type:
    displayName: Type
  file.name:
    displayName: Reunião
  note.org:
    displayName: Org
views:
  - type: table
    name: Reuniões
    order:
      - file.name
      - date
      - type
      - pessoas
    sort:
      - property: date
        direction: ASC
  - type: table
    name: Pessoa
    filters:
      and:
        - list(pessoas).contains(this)
    order:
      - file.name
      - date
      - type
      - pessoas
    sort:
      - property: date
        direction: ASC
  - type: table
    name: Tipo
    filters:
      and:
        - list(type).contains(this)
    order:
      - file.name
      - date
      - pessoas
      - org
    sort:
      - property: date
        direction: DESC

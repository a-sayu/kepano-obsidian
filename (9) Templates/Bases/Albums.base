filters:
  and:
    - note.categorias.contains(link("Albums"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Album
  note.year:
    displayName: Year
  note.artist:
    displayName: Artist
  note["criado em"]:
    displayName: Added
  note.avaliação:
    displayName: Avaliação
  note.genre:
    displayName: Genre
views:
  - type: table
    name: Albums
    order:
      - file.name
      - artist
      - avaliação
      - year
      - genre
    sort:
      - property: artist
        direction: DESC
  - type: table
    name: Artist
    filters:
      and:
        - list(artist).contains(this)
    order:
      - file.name
      - artist
      - avaliação
      - year
      - genre
  - type: table
    name: Genre
    filters:
      and:
        - list(genre).contains(this)
    order:
      - file.name
      - artist
      - avaliação
      - year
      - genre

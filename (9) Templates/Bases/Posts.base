properties:
  file.name:
    displayName: Title
  note.status:
    displayName: Status
  note.publicado:
    displayName: Publicado
views:
  - type: table
    name: All
    filters:
      and:
        - list(categorias).contains(link("Posts"))
        - '!file.name.contains("Template")'
    order:
      - file.name
      - status
      - publicado
    sort:
      - property: publicado
        direction: DESC

filters:
  and:
    - file.hasLink(this)
formulas:
  Path: file.path
properties:
  note["criado em"]:
    displayName: Date
  file.name:
    displayName: Title
  note.categorias:
    displayName: Categorias
views:
  - type: table
    name: Backlinks
    order:
      - file.name
      - categorias
      - created
    sort:
      - property: created
        direction: DESC
  - type: table
    name: Recent entries
    order:
      - file.name
      - created
    sort:
      - property: created
        direction: DESC
    limit: 20

filters:
  and:
    - categorias.contains(link("Companies"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Company
  property.url:
    displayName: Link
  note.url:
    displayName: URL
  note.pessoas:
    displayName: Pessoas
views:
  - type: table
    name: Companies
    order:
      - file.name
      - url
      - pessoas
    columnSize:
      note.url: 239

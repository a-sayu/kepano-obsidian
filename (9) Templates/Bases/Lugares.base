filters:
  and:
    - note.categorias.contains(link("Places"))
    - '!file.name.contains("Template")'
properties:
  note.type:
    displayName: Type
  note.avaliação:
    displayName: avaliação
  note.loc:
    displayName: Location
  file.name:
    displayName: Name
  note.last:
    displayName: Last
views:
  - type: table
    name: Places
    order:
      - file.name
      - avaliação
      - loc
      - type
      - last
    sort:
      - property: last
        direction: DESC
      - property: type
        direction: ASC
      - property: loc
        direction: ASC
    columnSize:
      file.name: 162
      note.loc: 145
      note.type: 199
  - type: table
    name: Localidade
    filters:
      and:
        - list(loc).contains(this)
    order:
      - file.name
      - type
      - avaliação
      - last
    sort:
      - property: avaliação
        direction: DESC
      - property: last
        direction: DESC
      - property: loc
        direction: ASC
    columnSize:
      note.type: 197
  - type: table
    name: Tipo
    filters:
      and:
        - list(type).contains(this)
    order:
      - file.name
      - type
      - avaliação
      - last
    sort:
      - property: last
        direction: DESC
      - property: loc
        direction: ASC
    columnSize:
      note.type: 153
  - type: table
    name: Related
    filters:
      and:
        - file.hasLink(this)
        - '!tags.containsAny("cities", "countries")'
    order:
      - file.name
      - avaliação
      - loc
      - type
      - last
    sort:
      - property: avaliação
        direction: DESC
      - property: last
        direction: DESC
      - property: type
        direction: ASC
      - property: loc
        direction: ASC
    columnSize:
      file.name: 162
      note.avaliação: 65
      note.loc: 145
      note.type: 199
  - type: table
    name: Metatype
    filters:
      or:
        - list(type).contains(this)
        - list(type).containsAny(this.topics)
    order:
      - file.name
      - type
      - avaliação
      - last
    sort:
      - property: last
        direction: DESC
      - property: loc
        direction: ASC
    columnSize:
      note.type: 153

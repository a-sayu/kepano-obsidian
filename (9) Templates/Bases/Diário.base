filters:
  or:
    - file.name.contains(this.file.name)
    - note["criado em"].toString().contains(this.file.name)
    - começo.toString().contains(this.file.name)
    - fim.toString().contains(this.file.name)
    - file.links.contains(this.file)
properties:
  file.name:
    displayName: Entry
  note.categorias:
    displayName: categorias
  note["criado em"]:
    displayName: Criado
  note.tags:
    displayName: Tags
views:
  - type: table
    name: Notas Diárias
    filters:
      and:
        - '!file.tags.contains("mensal")'
        - file.name != this.file.name
    order:
      - file.name
      - criado em
      - categorias
      - tags
    sort:
      - property: tags
        direction: ASC
      - property: file.name
        direction: ASC
      - property: categorias
        direction: ASC
    columnSize:
      file.name: 287
      note["criado em"]: 128
      note.categorias: 119
  - type: table
    name: Mensal
    filters:
      and:
        - '!file.tags.contains("diário")'
        - file.name != this.file.name
    order:
      - file.name
      - categorias
      - created
    sort:
      - property: file.name
        direction: ASC
      - property: created
        direction: DESC
  - type: table
    name: Yearly
    filters:
      and:
        - '!file.tags.contains("diário")'
        - '!file.tags.contains("mensal")'
        - file.name != this.file.name
    order:
      - file.name
      - categorias
      - created
    sort:
      - property: created
        direction: ASC

filters:
  and:
    - categorias.contains(link("Board games"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Game
  note.avaliação:
    displayName: avaliação
  note.last:
    displayName: Last
views:
  - type: table
    name: Table
    order:
      - file.name
      - avaliação
      - last

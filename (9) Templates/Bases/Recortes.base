filters:
  and:
    - categorias.contains(link("Recortes"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Title
  note.autor:
    displayName: Autor
  note["criado em"]:
    displayName: Clipped
  note.publicado:
    displayName: Publicado
  file.basename:
    displayName: nome
views:
  - type: table
    name: Recortes
    order:
      - file.basename
      - autor
      - criado em
      - publicado
    sort:
      - property: file.basename
        direction: DESC
      - property: created
        direction: ASC
    columnSize:
      note.autor: 140
  - type: table
    name: Autor
    filters:
      and:
        - list(autor).contains(this)
    order:
      - file.name
      - autor
      - created
      - publicado
    sort:
      - property: clipped
        direction: DESC

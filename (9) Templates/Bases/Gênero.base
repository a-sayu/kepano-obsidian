filters:
  and:
    - list(genre).contains(this)
properties:
  note.avaliação:
    displayName: avaliação
  note.categorias:
    displayName: Category
  note.last:
    displayName: Last
  file.name:
    displayName: Name
views:
  - type: table
    name: Gênero
    order:
      - file.name
      - avaliação
      - categorias
      - last
    sort:
      - property: avaliação
        direction: DESC
      - property: last
        direction: DESC
    columnSize:
      file.name: 248
      note.categorias: 170

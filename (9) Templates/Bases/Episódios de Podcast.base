filters:
  and:
    - note.categorias.contains(link("Episódios de Podcast"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Podcast
  note.show:
    displayName: Show
  note.convidados:
    displayName: Convidados
  note.episodio:
    displayName: Episodio
  note.avaliação:
    displayName: avaliação
  note.publicado:
    displayName: Publicado
  note.convidado:
    displayName: Convidado
views:
  - type: table
    name: All episodios
    order:
      - file.name
      - show
      - convidados
      - episodio
      - avaliação
      - publicado
    sort:
      - property: publicado
        direction: DESC
  - type: table
    name: Show
    filters:
      and:
        - list(show).contains(this)
    order:
      - file.name
      - show
      - episodio
      - avaliação
      - publicado
      - convidado
  - type: table
    name: Convidado
    filters:
      and:
        - list(convidado).contains(this)
    order:
      - file.name
      - show
      - convidados
      - episodio
      - avaliação
      - publicado

filters:
  and:
    - note.categorias.contains(link("Games"))
    - '!file.name.contains("Template")'
properties:
  file.name:
    displayName: Games
  note.year:
    displayName: Year
  note.maker:
    displayName: Maker
  note.avaliação:
    displayName: avaliação
  note.genre:
    displayName: Genre
  note.last:
    displayName: Last played
views:
  - type: table
    name: Games
    order:
      - file.name
      - maker
      - genre
      - year
      - avaliação
      - last
  - type: table
    name: Estúdio
    filters:
      and:
        - list(maker).contains(this)
    order:
      - file.name
      - maker
      - genre
      - year
      - avaliação
      - last
  - type: table
    name: Genre
    filters:
      and:
        - list(genre).contains(this)
    order:
      - file.name
      - maker
      - genre
      - year
      - avaliação
      - last
